# ============================================================
# Mem0 Standalone 部署环境变量模板
# 复制为 .env 并填入真实值后使用:
#   cp .env.standalone.example .env
# ============================================================

# ===== LLM 提供商: DeepSeek =====
MEM0_LLM_PROVIDER=deepseek
MEM0_DEFAULT_LLM_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ===== Embedder 提供商: Ollama (本地) =====
MEM0_EMBEDDER_PROVIDER=ollama
MEM0_DEFAULT_EMBEDDER_MODEL=bge-m3:latest
# Docker Desktop: http://host.docker.internal:11434
# Linux: http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ===== PostgreSQL =====
POSTGRES_HOST=your_postgres_host
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=postgres
POSTGRES_COLLECTION_NAME=memories
APP_DB_NAME=mem0

# ===== 认证 =====
AUTH_DISABLED=false
# 生成方式: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_here

# ===== Dashboard =====
DASHBOARD_URL=http://localhost:3001

# ===== 历史记录 =====
HISTORY_DB_PATH=/app/history/history.db

# ===== 遥测 =====
MEM0_TELEMETRY=false
